{
	"name": "kubipdf",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"assets": "node scripts/copy-pdfjs-assets.mjs",
		"predev": "node scripts/copy-pdfjs-assets.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/copy-pdfjs-assets.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"images": "node --experimental-strip-types --no-warnings scripts/generate-images.mjs",
		"serve": "node scripts/serve.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"@types/sortablejs": "^1.15.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@cantoo/fontkit": "^2.0.12",
		"@cantoo/pdf-lib": "^2.11.1",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"fflate": "^0.8.3",
		"pdfjs-dist": "^6.4.299",
		"sortablejs": "^1.15.7"
	},
	"description": "Free, private PDF editor and toolkit that runs entirely in the browser.",
	"engines": {
		"node": ">=22"
	}
}
